# ══════════════════════════════════════════════════════════════════
# Addis Eats — environment variables
# Copy this file to .env.local and fill in the values:
#     cp .env.example .env.local
# NEVER commit .env.local — it is gitignored. This file is committed
# and stays EMPTY of real secrets; it documents what the app needs.
# ══════════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────────────

# Secret used to SIGN the session cookie (HMAC-SHA256).
# Without it: sign-in fails in production ("SESSION_SECRET is required").
# Generate one:   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Absolute URL of this deployment — used for metadataBase, absolute
# og:image URLs, sitemap links and robots.
#   local dev:  http://localhost:3000
#   deployed:   https://your-app.vercel.app
# Without it: social previews and sitemap show localhost URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── OPTIONAL — Google sign-in ──────────────────────────────────────

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Register this redirect URI in Google:  <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
# While the OAuth app is in "Testing" mode, only listed test users can sign in.
# Without these two: the "Continue with Google" button simply does not render;
# password sign-in is unaffected.

GOOGLE_CLIENT_ID=215684805409-7kalu0mfslq6hulacogchl56m95k93r9.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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